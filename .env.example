# Puerto del servidor
PORT=3000

# Entorno: development | production
NODE_ENV=development

# Ruta del archivo SQLite (relativa a la raíz del proyecto)
DB_PATH=data/fitness.db

# Client ID de Google Cloud (OAuth 2.0, tipo Web).
# Déjalo vacío para usar solo el login de desarrollo.
GOOGLE_CLIENT_ID=

# Control de acceso: lista de correos (separados por comas) autorizados a
# crear/usar una cuenta con Google. Solo estas cuentas verificadas podrán
# entrar. Déjalo vacío para bloquear el login con Google (salvo que uses el
# escape hatch de abajo).
ALLOWED_EMAILS=

# Escape hatch explícito: pon true para aceptar CUALQUIER cuenta de Google
# verificada (instancia pública). En producción, si GOOGLE_CLIENT_ID está
# definido debes indicar ALLOWED_EMAILS o ALLOW_ANY_GOOGLE_USER=true, o la app
# se niega a arrancar.
ALLOW_ANY_GOOGLE_USER=false

# Permite el login local de prueba (opt-in explícito). Nunca funciona en
# producción. Debe valer exactamente "true" para activarse.
ALLOW_DEV_LOGIN=true

# Cookies seguras (pon true cuando sirvas por HTTPS). En producción se fuerza a
# true aunque pongas false, para proteger la cookie de sesión.
COOKIE_SECURE=false

# URL pública HTTPS de la app (sin barra final). Necesaria para registrar los
# webhooks de Hevy (sincronización en tiempo real). Ej: https://fitlog.midominio.me
PUBLIC_URL=

# Duración de la sesión en días
SESSION_DAYS=30

# Secreto interno (recomendado definirlo en producción)
SESSION_SECRET=cambia-este-secreto

# Días antes de volver a sincronizar el catálogo en segundo plano
CATALOG_SYNC_DAYS=14

# Sincronización con Hevy: tiempo límite por petición (ms), número de
# reintentos para lecturas (429/5xx/red) y backoff base (ms) con jitter.
HEVY_REQUEST_TIMEOUT_MS=20000
HEVY_MAX_RETRIES=3
HEVY_RETRY_BACKOFF_MS=500

# Copias de seguridad de la base de datos (scripts/backup-db.js).
# Directorio destino (fuera de data/). Por defecto <raíz>/backups.
BACKUP_DIR=backups
# Retención: copias diarias y semanales a conservar.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
