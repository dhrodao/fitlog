# Puerto del servidor
PORT=3000

# Entorno: development | production
NODE_ENV=development

# Ruta del archivo SQLite (relativa a la raíz del proyecto)
DB_PATH=data/fitness.db

# Client ID de Google Cloud (OAuth 2.0, tipo Web).
# Déjalo vacío para usar solo el login de desarrollo.
GOOGLE_CLIENT_ID=

# Permite el login local de prueba. Nunca lo actives en producción.
ALLOW_DEV_LOGIN=true

# Cookies seguras (pon true cuando sirvas por HTTPS)
COOKIE_SECURE=false

# URL pública HTTPS de la app (sin barra final). Necesaria para registrar los
# webhooks de Hevy (sincronización en tiempo real). Ej: https://fitlog.midominio.me
PUBLIC_URL=

# Duración de la sesión en días
SESSION_DAYS=30

# Secreto interno (recomendado definirlo en producción)
SESSION_SECRET=cambia-este-secreto

# Cloudflare Tunnel: token del túnel creado en el panel de Cloudflare Zero
# Trust. Déjalo vacío si no usas el servicio cloudflared del docker-compose.
TUNNEL_TOKEN=

# Días antes de volver a sincronizar el catálogo en segundo plano
CATALOG_SYNC_DAYS=14
